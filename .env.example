NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. The app never reads the service role key.
# SUPABASE_SERVICE_ROLE_KEY=

# naver | kakao | none
NEXT_PUBLIC_MAP_PROVIDER=none
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Server-only place search. Map tiles do not enable search.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
KAKAO_REST_API_KEY=

# Optional AI image provider. Leave empty to use local pixelation only.
IMAGE_AI_PROVIDER=
IMAGE_AI_API_KEY=
